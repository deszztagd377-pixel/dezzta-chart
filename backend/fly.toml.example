# Fly.io single-Machine deployment template for DEZZTA CHART.
# Copy to backend/fly.toml only after choosing the app name.
# Build context is backend/ because this file lives beside backend/Dockerfile.

app = "REPLACE_WITH_FLY_APP_NAME"
primary_region = "sin"

[build]
  dockerfile = "Dockerfile"

[env]
  APP_ENV = "production"
  PORT = "8000"
  INSTRUMENT_REGISTRY_DB_PATH = "/data/dezzta-chart.sqlite3"
  CORS_ALLOWED_ORIGINS = "https://dezzta-chart.vercel.app"
  FIREBASE_PROJECT_ID = "REPLACE_WITH_FIREBASE_PROJECT_ID"
  DATABENTO_LIVE_ENABLED = "false"
  DATABENTO_HISTORICAL_ENABLED = "false"

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = false

[[http_service.checks]]
  grace_period = "25s"
  interval = "30s"
  method = "GET"
  path = "/health"
  timeout = "5s"

[[mounts]]
  source = "dezzta_data"
  destination = "/data"
  snapshot_retention = 14
