# Copy to .env for local development. Never commit real credentials.
# Databento key is intentionally unused until live-feed integration is implemented.
DATABENTO_API_KEY=

# Required by the WebSocket authentication handshake.
# Generate a long random value locally; never share it in chat or commit it.
MARKET_DATA_WS_TOKEN=

# Comma-separated browser origins allowed to call the API.
# Example: http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_ENV=development
