# Copy to .env for local development. Never commit real credentials.
# Read ONLY by the backend. Without it the backend starts normally and reports
# the provider as disconnected. Never commit a real key.
DATABENTO_API_KEY=

# Phase 2 provider switches (all off by default).
DATABENTO_DATASET=GLBX.MDP3
DATABENTO_LIVE_ENABLED=false
# Explicit contract symbols only, e.g. ESZ6,NQZ6 (nothing is auto-selected).
DATABENTO_LIVE_SYMBOLS=
DATABENTO_HISTORICAL_ENABLED=false
# Parent symbols used ONLY for the definition schema (UNVERIFIED), e.g. ES.FUT
DATABENTO_DEFINITION_SYMBOLS=
DATABENTO_HISTORICAL_MAX_SPAN_HOURS=24
DATABENTO_HISTORICAL_WINDOW_MINUTES=60
# Product-root allow-list (default configuration, not an architectural limit).
INSTRUMENT_ROOTS=ES,NQ,GC
OHLCV_QUEUE_MAX=10000
OHLCV_MAX_RESPONSE_BARS=5000

# Persistent canonical instrument registry (mount a durable volume in production).
INSTRUMENT_REGISTRY_DB_PATH=./data/instrument_registry.sqlite3

# Firebase project used by backend Admin SDK token verification.
# Optional in local development; mandatory when APP_ENV=production.
# This is a project identifier, not a service-account credential.
FIREBASE_PROJECT_ID=

# Required by the WebSocket authentication handshake.
# Generate a long random value locally; never share it in chat or commit it.
MARKET_DATA_WS_TOKEN=

# Comma-separated browser origins allowed to call the API.
# Example: http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_ENV=development

# Optional private HTTP metrics endpoint. Leave empty to disable it.
# Inject a random 32-256 character token through the host secret store.
# GET /internal/metrics requires Authorization: Bearer <token>.
# Metrics are process-local and reset on restart; not durable monitoring.
OBSERVABILITY_METRICS_TOKEN=


# Optional encrypted device-registration store. Disabled by default.
ALERT_DEVICE_STORE_ENABLED=false
# Absolute path to a protected Base64 file containing exactly 32 decoded bytes.
# Keep the key file outside the repository and Docker build context.
# The backend process must be able to read it; group/other permission bits must be zero.
ALERT_DEVICE_ENCRYPTION_KEY_FILE=

# External FCM delivery worker is disabled by default.
# Enabling it requires ALERT_DEVICE_STORE_ENABLED and FIREBASE_PROJECT_ID.
ALERT_DELIVERY_WORKER_ENABLED=false

# Optional shared Redis URL for local development. Production requires rediss://
# with a non-empty ACL username and password.
REDIS_URL=
# Optional absolute path to a PEM CA bundle for a private Redis TLS CA.
# Leave empty to use the operating-system CA trust store. Hostname validation
# remains mandatory; the Redis URL hostname must match the certificate SAN.
REDIS_TLS_CA_CERTS=

# Optional source OHLCV relay. Disabled unless explicitly enabled AND an
# owner-injected publisher_runtime_factory is supplied to create_app().
# Requires an existing SQLite publisher checkpoint and a host snapshot
# verifier confirming the same generation/cursor on every required gateway.
# Use a dedicated publisher ACL identity, not the shared REDIS_URL.
# Production requires rediss:// and exact-key ACL commands +ping +xadd +xrange.
OHLCV_REDIS_ENABLED=false
OHLCV_REDIS_PUBLISH_URL=
OHLCV_REDIS_PUBLISHER_OWNER=
OHLCV_REDIS_STREAM_KEY=dezzta:market-data:ohlcv:v1

# Optional bearer token for the internal incident-operator endpoints.
# When supplied, use a random 32-256 character value; never commit the real token.
OPERATOR_INCIDENT_TOKEN=

# Optional owner-operated gateway replica runtime. Disabled unless an
# authenticated snapshot installer is injected into create_app().
# The callback must fetch/authorize the snapshot, call
# SQLiteOhlcvReplicaStore.install_global_snapshot(), and return its metadata.
# Production requires a dedicated rediss:// gateway ACL identity.
OHLCV_REDIS_GATEWAY_URL=
OHLCV_REDIS_REPLICA_DATABASE_PATH=
OHLCV_REDIS_SOURCE_ID=
OHLCV_REDIS_GATEWAY_CONSUMER_NAME=
