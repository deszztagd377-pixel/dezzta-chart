# Copy to .env for local development. Never commit real credentials.
# Read ONLY by the backend. Without it the backend starts normally and reports
# the provider as disconnected. Never commit a real key.
DATABENTO_API_KEY=

# Phase 2 provider switches (all off by default).
DATABENTO_DATASET=GLBX.MDP3
DATABENTO_LIVE_ENABLED=false
# Explicit contract symbols only, e.g. ESZ6,NQZ6 (nothing is auto-selected).
DATABENTO_LIVE_SYMBOLS=
DATABENTO_HISTORICAL_ENABLED=false
# Parent symbols used ONLY for the definition schema (UNVERIFIED), e.g. ES.FUT
DATABENTO_DEFINITION_SYMBOLS=
DATABENTO_HISTORICAL_MAX_SPAN_HOURS=24
DATABENTO_HISTORICAL_WINDOW_MINUTES=60
# Product-root allow-list (default configuration, not an architectural limit).
INSTRUMENT_ROOTS=ES,NQ,GC
OHLCV_QUEUE_MAX=10000
OHLCV_MAX_RESPONSE_BARS=5000

# Required by the WebSocket authentication handshake.
# Generate a long random value locally; never share it in chat or commit it.
MARKET_DATA_WS_TOKEN=

# Comma-separated browser origins allowed to call the API.
# Example: http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_ENV=development
